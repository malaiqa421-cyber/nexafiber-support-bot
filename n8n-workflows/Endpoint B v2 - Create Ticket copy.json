    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nlet raw = String($input.first().json.text || '').replace(/```json|```/g, '').trim();\n\nlet r = null;\ntry { r = JSON.parse(raw); }\ncatch (e) {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  try { r = JSON.parse(m ? m[0] : ''); } catch (e2) { r = null; }\n}\n\nconst q = String(body.question || '');\nconst a = String(body.answer || '');\nconst email = String(body.email || '').trim();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n// Rule-based decision: the AI only suggests priority and category.\nconst wantsHuman = /(human|real person|technician|insaan|agent se)/i.test(q);\nconst unanswered = /((could not|couldn't|cannot|can't|unable to) find|(do not|don't|does not) (currently )?have (any )?(specific |reliable )?information|pass(ing)? (your|the) question|maloomat nahi|no information)/i.test(a);\nconst persists = /(still (not working|down|locked|slow)|abhi bhi|phir bhi|did not help|didn't help|not helpful|nahi chala|nahi chal raha)/i.test(q);\n\nlet escalate = wantsHuman || unanswered || persists;\nif (!emailOk || !q.trim()) escalate = false;\n\nconst priorities = ['low', 'medium', 'urgent'];\n\nreturn [{\n  json: {\n    escalate,\n    email,\n    question: q.slice(0, 1000),\n    ai_answer: a.slice(0, 2000),\n    user_feedback: r && r.reason ? String(r.reason).slice(0, 300) : 'Auto-escalated',\n    category: (r && r.category) || 'Other',\n    priority: priorities.includes(r && r.priority) ? r.priority : 'medium',\n    source: 'auto',\n    conversation: Array.isArray(body.conversation) ? body.conversation : []\n  }\n}];"
      },
