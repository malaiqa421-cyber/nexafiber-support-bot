    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer question: {{ $json.body.question }}\nAssistant answer: {{ $json.body.answer }}",
        "messages": {
          "messageValues": [
            {
              "message": "You review a customer support chat for NexaFiber Networks and decide if a human support ticket is needed.\nReturn ONLY a JSON object, no markdown:\n{\"needs_escalation\": true, \"priority\": \"low\", \"category\": \"Other\", \"reason\": \"short reason\"}\n\nneeds_escalation = false when the assistant gave concrete steps or facts that answer the question. This stays false even if the answer ends with a polite line such as \"contact support if it still does not work\". Also false for greetings or thanks, and when an area outage with an ETA explains the problem and the customer did not say it continues.\n\nneeds_escalation = true only when: the assistant said it could not find the information or is passing the question to the support team; or the customer asks for a human, an agent or a technician; or the customer says the answer did not help or the problem still continues; or the issue clearly needs a technician, a billing review or a suspended-service review.\n\npriority: urgent = service suspended, no internet for a long time, or an angry customer; medium = needs follow-up; low = minor.\ncategory: one of Account, Plans, Billing, Installation, Router, Troubleshooting, Outage, Policy, Support, Coverage, Other."
            }
          ]
        },
        "batching": {}
      },
