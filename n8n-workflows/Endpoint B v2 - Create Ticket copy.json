    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\n\nconst ticket_id = 'TCK-' + Math.floor(100000 + Math.random() * 900000);\n\nconst p = String(b.priority || '').toLowerCase();\nconst priority = ['low', 'medium', 'urgent'].includes(p) ? p : 'medium';\nconst source = b.source === 'auto' ? 'auto' : 'manual';\n\nconst conv = Array.isArray(b.conversation) ? b.conversation.filter(m => String(m.text || '').trim()).slice(-12) : [];\nconst conversation = conv\n  .map(m => (m.role === 'user' ? 'Customer: ' : 'Assistant: ') + String(m.text || '').slice(0, 500))\n  .join('\\n');\n\nreturn [{\n  json: {\n    ticket_id,\n    email: String(b.email).trim(),\n    question: String(b.question).trim().slice(0, 1000),\n    ai_answer: String(b.ai_answer || '').slice(0, 2000),\n    user_feedback: String(b.user_feedback || '').slice(0, 500),\n    conversation,\n    category: String(b.category || 'Other').slice(0, 50),\n    priority,\n    source,\n    status: 'Open'\n  }\n}];"
      },
